{
	"name": "n8n-nodes-netsuite-rest",
	"version": "0.1.15",
	"description": "n8n community node for NetSuite: SuiteTalk REST API, 150+ standard record types, custom records, custom fields and SuiteQL queries. OAuth 2.0.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-nodes",
		"netsuite",
		"oracle-netsuite",
		"netsuite-rest",
		"suitetalk",
		"suiteql",
		"erp",
		"integration",
		"automation"
	],
	"license": "MIT",
	"homepage": "https://integrationstars.com/n8n/blog/n8n-netsuite-integration/",
	"author": {
		"name": "Eric Popivker",
		"email": "en@entechsolutions.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/entech-code/n8n-nodes-netsuite-rest.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons && gulp copy:schema",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json",
		"test": "jest --config jest.config.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/NetSuiteRestOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/NetSuiteRest/NetSuiteRest.node.js",
			"dist/nodes/JsonTogglePoc/JsonTogglePoc.node.js"
		]
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@typescript-eslint/parser": "~8.32.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"jest": "^30.1.3",
		"prettier": "^3.5.3",
		"ts-jest": "^29.4.1",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
